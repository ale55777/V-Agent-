# Copy to .env, or let scripts/setup.ps1 generate it with random secrets.
# Never commit .env.

ECHOAI_SECRET_KEY=generate-a-random-string-of-at-least-32-characters

# PostgreSQL (the container is bound to 127.0.0.1 only)
POSTGRES_USER=echoai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=echoai
POSTGRES_PORT=5432
ECHOAI_DATABASE_URL=postgresql+asyncpg://echoai:change-me@127.0.0.1:5432/echoai

# Network. The backend listens on all interfaces; clients use the address they
# loaded the page from, so ECHOAI_LAN_IP is only used for printed links.
ECHOAI_HOST=0.0.0.0
ECHOAI_PORT=8000
ECHOAI_LAN_IP=
ECHOAI_CORS_ORIGINS=
# Set both to serve HTTPS/WSS (scripts/start.ps1 -Https does this).
# ECHOAI_TLS_CERT=certs/echoai.crt
# ECHOAI_TLS_KEY=certs/echoai.key

# Models (all local, no API keys)
ECHOAI_OLLAMA_URL=http://127.0.0.1:11434
ECHOAI_LLM_MODEL=qwen2.5:0.5b-instruct
ECHOAI_STT_MODEL=tiny
# auto benchmarks at startup, and picks Kokoro only if it keeps up with real time
ECHOAI_TTS_ENGINE=auto

# Optional online engine. With a key set, Settings offers "Groq (fast, online)" next to
# the local engine. It sends your audio and text to Groq; the local models stay the fallback.
# Free key: https://console.groq.com/keys
ECHOAI_GROQ_API_KEY=
# ECHOAI_GROQ_LLM_MODEL=qwen/qwen3.8-27b
# ECHOAI_GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional electricity estimate. Leave the price unset to hide it from reports.
ECHOAI_POWER_WATTS=25
# ECHOAI_ELECTRICITY_PRICE_PER_KWH=0.15
